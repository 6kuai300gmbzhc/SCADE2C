-- Not so simple "tupled" node call

node minmax6(a,b,c,d,e,f:int32)
	returns (n1,n2,n3,n4,n5,n6:int32)
var
	min_ab, MAX_ab :int32;
	min_cd, MAX_cd :int32;
	min_ef, MAX_ef :int32;
	
	m1,m2,m4,m5 :int32;
	M1,M2,M3,M5 :int32;


let
	min_ab, MAX_ab = minmax(a,b);	
	min_cd, MAX_cd = minmax(c,d);
	min_ef, MAX_ef = minmax(e,f);
	
	m1,M1 = minmax(min_cd, min_ef);
	m2,M2 = minmax(MAX_ab, MAX_cd);

	n1,M3 = minmax(min_ab, m1);
	m4,n6 = minmax(M2, MAX_ef);
	
	m5,M5 = minmax(M1, m2);
	
	n2,n3 = minmax(M3, m5);
	n4,n5 = minmax(M5, m4);
tel


node minmax(a,b:int32)
	returns (min,max:int32)
let
	min,max = if (a<=b) then (a,b) else (b,a);
tel
