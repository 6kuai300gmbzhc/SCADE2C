node ifSystem1 (
    in1,
    in2: float32;
    in3: bool)
returns (
    entrytime1,
    entrytime2: float32;
    slopeFlt: bool)
let
    entrytime1 = if ( false->pre(in3) ) = true then 0.0
                 else in1 + 1.0;
    entrytime2 = 0.0;
    slopeFlt = if ( false->pre(in3) ) = true then false->pre(in3)
               else if in1 + 1.0 >= 2.0 then true
               else true;
tel

node ifSystem2 (
    in1,
    in2: float32;
    in3: bool)
returns (
    entrytime1,
    entrytime2: float32;
    slopeFlt: bool)
let
    entrytime1 = 0.0;
    entrytime2 = if ( false->pre(in3) ) = true then in1+1.0
                 else 0.0;
    slopeFlt = if ( false->pre(in3) ) = true then ( if in1 + 1.0 >= 2.0 then true else false )
               else false->pre(in3);
tel

node slope1 (
    Speed: float32;
    RangeFlt: bool)
returns (
    SpeedOut: float32;
    SlopeFlt: bool)
var
    SpeedAbs: float32;
    Flt: bool;
    InvBool: bool;
    Inv: float32;
    i: int32;
let
    SpeedAbs =  if Speed - (0.0 -> pre(Speed)) >= 0.0 then Speed - (0.0 -> pre(Speed))
                else (0.0 -> pre(Speed)) - Speed;
    InvBool =  if SpeedAbs > SlopeLimit then true
                else false;
    Inv = if InvBool then 1.0
            else 0.0;
    Flt =  true ->  if pre(Flt) = true then
                            (if pre(i) + 1 >= 4 then false else pre(Flt))
                        else
                            (if pre(i) + 1 >= 4 then true else pre(Flt));
    i = 0 ->    if pre(Flt) = true then
                    if Inv = 0.0 then
                        if pre(i) + 1 >= 4 then 0
                        else pre(i) +1
                    else 0
                else
                    if Inv = 1.0 then
                        if pre(i) + 1 >= 4 then 0
                        else pre(i) +1
                    else 0;
    SpeedOut = if InvBool and Flt then 0.0
                else Speed;
    SlopeFlt = Flt or RangeFlt;


tel

