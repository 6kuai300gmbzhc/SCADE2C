const
    rangeMax: float32 = 300.0;
    rangeMin: float32 = 0.0;
    rangeSetTime: float32 = 5.0;
    rangeClrTime: float32 = 10.0;
    procTime: float32 = 1.0;
    isRange: float32 = 0.0;
    init : float32 = 0.0;
    q : float32 = 0.002;
    r : float32 = 0.05;
    voteData: float32 = 150.0;
    slopeWaveLimit: float32 = 1000.0;
    slopeSetTime: float32 = 5.0;
    slopeClrTime: float32 = 5.0;
    warpLimit: float32 = 1000.0;
    esMode: float32 = 6.0;
    constant: float32 = 1.0;
    constant1: float32 = 0.0;
    constant2: bool = false;
    constant3: bool = false;
    constant4: float32 = 1.0;
    constant5: float32 = 1.0;
    constant6: float32 = 0.0;
    AngularSubtract1_sub: float32 = 180.0;
    SlopeLimit: float32 = 100.0;
node extreValue1 (
    rangeIn: float32)
returns (
    rangeOut: float32;
    rangeFlt: bool)
var
    rangeInv1,
    rangeFlt1,
    rangeInv2: bool;
    setCyc,
    clrCyc,
    cycle1,
    cycle2: float32;
let
    setCyc = rangeSetTime / procTime;
    clrCyc = rangeClrTime / procTime;
    cycle1 = if rangeInv2 then (0.0 -> pre(cycle1) + 1.0) else 0.0;
    cycle2 = if not rangeInv2 then (0.0 -> pre(cycle2) + 1.0) else 0.0;
    rangeInv1 = if rangeMax<rangeIn or rangeIn < rangeMin then true
                else false;
    rangeInv2 = if isRange = 1.0 then true
                else rangeInv1;
    rangeFlt1 = if rangeInv1 = true then (if cycle1 >= setCyc then true else false)
                else (if cycle2 >= clrCyc then false else true);
    rangeFlt = true -> (if isRange = 1.0 then true
                else rangeFlt1);
    rangeOut =  if rangeInv2 and rangeFlt then 0.0
                else rangeIn;
tel

