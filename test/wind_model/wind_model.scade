node karman1(
    KFIn: float32)
returns (
    KFOut: float32)
var
    var1,
    var2,
    var3: float32;
let
    var2 = q + init + (0.0 -> pre(var1));
    var3 = var2 / (var2 + r);
    var1 = var2 - var2 * var3;
    KFOut = (0.0 -> pre(KFOut)) + var3 * (KFIn - (0.0 -> pre(KFOut)));
tel

