(*  This file is a trivial test for dependency analysis *)
(* time_in_min must be calculated before minute and hour *)

node dependeur(
		time_in_ms:int32 -- time of the day in millisecond from 00:00
		) returns (hour:int32;
			minute:int32;
			second:int32;
			ms:int32)
var
	time_in_min: int32;
	time_in_second: int32;
let
	
	hour = time_in_min / 60 ;
	minute = time_in_min mod 60 ;
	time_in_min = time_in_second / 60 ;
	second = time_in_second mod 60 ;
	time_in_second = time_in_ms / 1000 ;
	ms = time_in_ms mod 1000 ;
	
tel
