-- Not so simple "tupled" node call
-- Use a proc call instead of a node .

node minmax5(a,b,c,d:int32)
	returns (n1,n2,n3,n4:int32)
var
	min_ab, MAX_ab :int32;
	min_cd, MAX_cd :int32;
	
	MAX__minab_mincd:int32;
	min__MAXab_MAXcd:int32;
let
	min_ab, MAX_ab = minmax(a,b) ;
	
	min_cd, MAX_cd = minmax(c,d) ;
	
	n1,MAX__minab_mincd = minmax(min_ab,min_cd);
	min__MAXab_MAXcd,n4 = minmax(MAX_ab,MAX_cd);
	
	n2,n3 = minmax(MAX__minab_mincd,min__MAXab_MAXcd);
tel
function minmax(a,b:int32) returns (min,max:int32)
let
    min = if a<b then a else b;
    max = if a<b then b else a;
tel
