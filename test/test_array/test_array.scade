const N:int32=2;
const M:int32=3;
function test_array(in1:int32^M;in2:int32^M^N) returns(out1:int32^M;out2:int32^(2*M);out3:int32;out4:int32^N;out5:int32;out6:int32^N^M;out7:int32^M;out8:int32^M)
let
	out1=reverse in1;
	out2=in1 @ out1;
	out3=in1[N];
	out4=in1[0..1];
	out5=(out1.[1] default 2)+(out1.[100] default 2);

	out6=transpose(in2;1;2);
	out7=3^M;
	out8=[1,2,3];
tel