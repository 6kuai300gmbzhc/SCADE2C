    (253) empty -> .
    (121) Const_block -> . CONST Const_block_1
    (9) Type_block -> . TYPE Type_block_1
    (133) Sensor_block -> . SENSOR Sensor_block_1
    (24) Package_decl -> . Package Visibility_zero_or_one Pack_Lv6id Decls_zero_or_more END SEMICOLON
    (25) User_op_decl -> . Op_kind Interface_status User_op_decl_Lv6id User_op_decl_1 In_Params RETURNS Out_Params User_op_decl_2 User_op_decl_3 Opt_body
    (120) Package -> . PACKAGE
    (29) Op_kind -> . FUNCTION
    (30) Op_kind -> . NODE

    $end            reduce using rule 253 (empty -> .)
    CONST           shift and go to state 10
    TYPE            shift and go to state 11
    SENSOR          shift and go to state 12
    PACKAGE         shift and go to state 15
    FUNCTION        shift and go to state 16
    NODE            shift and go to state 17

    Program                        shift and go to state 1
    Decls_zero_or_more             shift and go to state 2
    Decls                          shift and go to state 3
    empty                          shift and go to state 4
    Const_block                    shift and go to state 5
    Type_block                     shift and go to state 6
    Sensor_block                   shift and go to state 7
    Package_decl                   shift and go to state 8
    User_op_decl                   shift and go to state 9
    Package                        shift and go to state 13
    Op_kind                        shift and go to state 14

state 1

    (0) S' -> Program .



state 2

