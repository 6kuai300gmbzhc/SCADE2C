    (24) Package_decl -> . Package Visibility_zero_or_one Pack_Lv6id Decls_zero_or_more END SEMICOLON
    (25) User_op_decl -> . Op_kind Interface_status User_op_decl_Lv6id User_op_decl_1 In_Params RETURNS Out_Params User_op_decl_2 User_op_decl_3 Opt_body
    (120) Package -> . PACKAGE
    (29) Op_kind -> . FUNCTION
    (30) Op_kind -> . NODE

    $end            reduce using rule 253 (empty -> .)
    END             reduce using rule 253 (empty -> .)
    CONST           shift and go to state 10
    TYPE            shift and go to state 11
    SENSOR          shift and go to state 12
    PACKAGE         shift and go to state 15
