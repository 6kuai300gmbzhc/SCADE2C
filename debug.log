node errtovi0(
    err : float64 last = 0;
    Num0 : float64 last = 0;
    vi0 : float64 last = 0;
    vi10 : float64 last = 0)
  returns (
    vi : float64 last = 0;
    temp4 : float64 last = 0;
    Num : float64 default = 0 last = 0;
    vi1 : float64 last = 0)
var
  _L1 : float64;
  _L2 : float64;
  _L3 : float64;
let
  _L1= err;
  _L2= D_Vit1;
  _L3= _L1  - _L2;
  temp4= _L3;
  activate IfBlock1 if temp4  <= 0
    then let
      Num= Num0  + 0.02;
      vi= vi10  - Ts  * Ts  * Num  * Num  * ki2;
    tel
    else if temp4  > D_Vit2
    then let
      Num= 0;
      vi= vi0  + Ts  * ki1;
      vi1= vi;
    tel
    else let
      Num= 0;
      vi= vi0  + Ts  * ki3  * temp4;
      vi1= vi;
    tel
  returns ..;
tel

