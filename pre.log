      then var
        _L6 : float64;
        _L5 : float64;
        _L4 : float64;
        _L2 : float64;
        _L9 : float64;
      let
        Tb= _L5;
        _L2= P0;
        _L4= Pb;
        _L5= _L9  * _L6;
        _L6= _L4  - _L2;
        _L9= k2;
      tel
      else if last 'Tb  / k2  + P0  < Pb  and last 'Pr  > Pb
      then let
        Tb= last 'Tb;
      tel
      else if last 'Tb  / k1  + P0  > Pb  and last 'Pr  < Pb
      then let
        Tb= last 'Tb;
      tel
      else if last 'Tb  / k1  + P0  < Pb  and Pm  >= Pb
      then let
        Tb= k1  * (Pb  - P0);
      tel
      else let
        Tb= last 'Tb;
      tel
    returns ..;
    Pr= _L13;
    _L13= Pb;
    Kb= _L14;
    _L14= _L15  / _L16;
    _L15= Tsm;
    _L16= 21;
  tel

end;



