node temporal_fby(input: int32) returns(output: int32; previous: int32; difference: int32; bounded: bool)
let
	output = fby(0; 1; smooth(input));
	previous = 0 -> pre output;
	difference = output - clamp_step(previous);
	bounded = is_bounded(output);
tel

function smooth(value: int32) returns(result: int32)
let
	result = if value < 0 then 0 else value;
tel

function clamp_step(value: int32) returns(result: int32)
let
	result = if value > 10 then 10 else if value < 0 then 0 else value;
tel

function is_bounded(value: int32) returns(result: bool)
let
	result = value >= 0 and value <= 10;
tel
