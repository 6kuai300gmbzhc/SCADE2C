  node #pragma kcg doc "Date_1" {Date = " $Date$"} #end
    #pragma kcg doc "Version_1" {Version = " $Revision$"} #end
    #pragma kcg doc "Author_1" {Author = " Created by : ANSYS"} #end
    #pragma kcg doc "Title_1" {Title = " Title : Top Level of the Cruise Control application"} #end
    CruiseControl(
      On : bool;
      Off : bool;
      Resume : bool;
      Set : bool;
      QuickAccel : bool;
      QuickDecel : bool;
      Accel : tPercent;
      Brake : tPercent;
      Speed : tSpeed)
    returns (
      CruiseSpeed : tSpeed default = ZeroSpeed;
      ThrottleCmd : tPercent default = Accel;
      CruiseState : tCruiseState default = OFF)
  let

    automaton SM1
      initial state Off
        unless
          if On restart Enabled;
        let
        tel

      state Enabled
        unless
          if Off restart Off;
        var
          local_CruiseSpeed : tSpeed;
          _L9 : bool;
          _L8 : tSpeed;
          _L7 : bool;
          _L6 : bool;
          _L5 : tSpeed;
        let

          automaton SM2
            initial state Active
              unless
                if Brake #4 > PedalsMin restart Interrupt;
              var
                StdbyCondition : bool;
                _L4 : bool;
                _L3 : bool;
                _L2 : bool;
                _L1 : bool;
              let

                automaton SM3
                  initial state On
                    unless
                      if StdbyCondition restart StandBy;
                    var
                      _L3 : tPercent;
                      _L8 : tSpeed;
                      _L11 : tSpeed;
                      _L12 : tCruiseState;
                    let
                      _L3= #2 CruiseRegulation(_L11, _L8);
                      _L8= Speed;
                      ThrottleCmd= _L3;
                      CruiseState= _L12;
                      _L11= local_CruiseSpeed;
                      _L12= ON;
                    tel

                  state StandBy
                    unless
                      if #1 not StdbyCondition restart On;
                    var
                      _L3 : tCruiseState;
                    let
                      CruiseState= _L3;
                      _L3= STDBY;
                    tel
                returns ..;
                _L1= Speed #2 > SpeedMax;
                _L2= _L3 #1 or _L4 #1 or _L1;
                _L3= Accel #1 > PedalsMin;
                _L4= Speed #1 < SpeedMin;
                StdbyCondition= _L2;
              tel

            state Interrupt
              unless
                if Resume restart Active;
              var
                _L3 : tCruiseState;
              let
                CruiseState= _L3;
                _L3= INT;
              tel
          returns ..;
          _L5= Speed;
          _L6= Set;
          CruiseSpeed= _L8;
          _L7= QuickAccel;
          _L8= #1 CruiseSpeedMgt(_L6, _L7, _L9, _L5);
          _L9= QuickDecel;
          local_CruiseSpeed= _L8;
        tel
    returns ..;
  tel

  node CruiseSpeedMgt(
      Set : bool;
      QuickAccel : bool;
      QuickDecel : bool;
      Speed : tSpeed)
    returns (CruiseSpeed : tSpeed last = Speed)
  var
    LocalCruiseSpeed : tSpeed;
    _L43 : tSpeed;
    _L42 : tSpeed;
  let
    activate IfBlock1 if Set
      then var
        _L2 : tSpeed;
      let
        _L2= Speed;
        LocalCruiseSpeed= _L2;
      tel
      else if QuickAccel
      then var
        _L1 : tSpeed;
        _L2 : float32;
        _L3 : tSpeed;
      let
        _L1= last 'CruiseSpeed;
        _L2= _L1 #1 + _L3;
        LocalCruiseSpeed= _L2;
        _L3= SpeedInc;
      tel
      else if QuickDecel
      then var
        _L2 : tSpeed;
        _L4 : float32;
        _L3 : tSpeed;
      let
        _L2= last 'CruiseSpeed;
        _L4= _L2 #1 - _L3;
        LocalCruiseSpeed= _L4;
        _L3= SpeedInc;
      tel
      else var
        _L1 : tSpeed;
      let
        _L1= last 'CruiseSpeed;
        LocalCruiseSpeed= _L1;
      tel
    returns ..;
    CruiseSpeed= _L42;
    _L42= #1 pwlinear::LimiterUnSymmetrical(_L43, SpeedMin, SpeedMax);
    _L43= LocalCruiseSpeed;
  tel

end;

