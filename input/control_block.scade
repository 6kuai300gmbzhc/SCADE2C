package pbtb

const k1 : float64 = Tsm / Pm ;
const k2 : float64 = Tsm / Px ;
const P0 : float64 = 0.0 ;
const Pm : float64 = 21000000.0 ;
const Px : float64 = 19000000.0 ;
const Tsm : float64 = 20000 ;

node pbtb ( Pb : float64 ;t : float64 ) 
returns ( Tb : float64 default = 7000 last = 7000 ;Kb : float64 last = Tsm / 21 ;Pr : float64 default = Pb last = Pb ) 
var 
_L13 : float64 ;
_L14 : float64 ;
_L15 : float64 ;
_L16 : float64 ;
let
    activate IfBlock1 if Pb < P0 then 
    let
        Tb = 0.0 ;
    tel
    else if last ' Tb / k2 >= Pb and Pb > P0 then 
    var 
    _L6 : float64 ;
    _L5 : float64 ;
    _L4 : float64 ;
    _L2 : float64 ;
    _L9 : float64 ;
    let
        Tb = _L5 ;
        _L2 = P0 ;
        _L4 = Pb ;
        _L5 = _L9 * _L6 ;
        _L6 = _L4 - _L2 ;
        _L9 = k2 ;
    tel
    else if last ' Tb / k2 + P0 < Pb and last ' Pr > Pb then 
    let
        Tb = last ' Tb ;
    tel
    else if last ' Tb / k1 + P0 > Pb and last ' Pr < Pb then 
    let
        Tb = last ' Tb ;
    tel
    else if last ' Tb / k1 + P0 < Pb and Pm >= Pb then 
    let
        Tb = k1 * ( Pb - P0 ) ;
    tel
    else let
        Tb = last ' Tb ;
    tel
    returns .. ;
    Pr = _L13 ;
    _L13 = Pb ;
    Kb = _L14 ;
    _L14 = _L15 / _L16 ;
    _L15 = Tsm ;
    _L16 = 21 ;
tel
end;


package antiskidwithoutVp
const Constant1 : float64 = 0.0 ;
node t ( ) returns ( t : float64 last = 0 ) 
var 
_L4 : float64 ;
_L5 : float64 ;
_L7 : float64 ;
_L8 : float64 ;
let
    t = _L5 ;
    _L4 = 0.001 ;
    _L5 = _L8 + _L4 ;
    _L7 = pre ( _L5 ) ;
    _L8 = ( 0 ) -> ( _L7 ) ;
tel

node t_to_Tsm ( vw0 : float64 last = 70 ) returns ( edge : bool ; 
Return : bool last = false ;
vw : float64 default = 70 last = 70 ; 
a : float64 default = 0 last = 0 )
var 
_L1 : float64 ;
_L6 : float64 ;
_L7 : float64 ;
_L8 : bool ;
_L9 : float64 ;
_L10 : float64 ;
let
    _L1 = t ( ) ;
    edge = _L8 ;
    automaton SM1 initial state State1 
    let
        vw = last ' vw ;
        Return = false ;
        a = last ' a ;
    tel
    until if 19 times edge do 
    let
    tel
    restart State2 ;
    state State2 
    let
        vw = vw0 ;
        Return = true ;
        a = last ' a + 1 ;
    tel
    until if true do 
    let
    tel
    restart State1 ;
    returns .. ;
    _L6 = pre ( _L1 ) ;
    _L7 = ( 0 ) -> ( _L6 ) ;
    _L8 = _L9 > _L10 ;
    _L9 = _L1 - _L7 ;
    _L10 = 0 ;
tel
end;