
package FlightControl
  open UnitConversionsConstants;
  open RegulationConstants;
  open AlarmConstants;
  package AlarmConstants
    const alarmSpeedThreshold : float32 = 85.0;

    const alarmAltThreshold : float32 = 100.0;

    const alarmSpeedTimer : int32 = 22;

    const alarmAltTimer : int32 = 18;

  end;

  package RegulationConstants
    const speedKp : float32 = 2.0;

    const speedKi : float32 = 6.0;

    const speedMin : float32 = - 500.0;

    const speedMax : float32 = 500.0;

    const ElevatorLimit : float32 = 1.56;

