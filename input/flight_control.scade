      JV_Alti_Alarm : bool)
  var
    SpeedTarget : float32;
    AltitudeTarget : float32;
    _L10 : float32;
    _L11 : float32;
    _L20 : float32;
    _L18 : float32;
    _L17 : float32;
    _L16 : float32;
    _L15 : float32;
    _L34 : bool;
    _L35 : bool;
    _L36 : float32;
    _L40 : float32;
    _L41 : float32;
    _L42 : float32;
    _L43 : bool;
  let
    _L15, _L16, _L17, _L18, _L20= #1 DisplayLogic(_L36, _L40, _L43);
    _L35, _L34= #1 AlarmManager(_L36, _L41, _L42, _L40);
    _L10, _L11= #1 FlightController(_L36, _L41, _L42, _L40);
    _L36= speed;
    _L40= altitude;
    throttleCmd= _L10;
    elevatorCmd= _L11;
    JV_Speed_Alarm= _L35;
    SDY_Pitch_Angle= _L16;
    SDY_Roll_Angle= _L17;
    SDY_Alti= _L18;
    SDY_Baro_Scale= _L20;

    automaton FlightMode
      initial state MANUAL
        unless
          if AutoPilot restart AUTOPILOT;
        let
          SpeedTarget= (speed) #1 -> (last 'SpeedTarget);
          AltitudeTarget= (altitude) #2 -> (last 'AltitudeTarget);
        tel

      state AUTOPILOT
        unless
          if #1 not AutoPilot do let tel restart MANUAL;
        var
          _L3 : float32;
          _L4 : float32;
          _L5 : float32;
          _L6 : float32;
        let
          SpeedTarget= _L6;
          AltitudeTarget= _L5;
          _L3= MCPaltitude;
          _L4= MCPspeed;
          _L5= #2 UnitConvert(_L3, FTtoM);
          _L6= #1 UnitConvert(_L4, KTStoKMH);
        tel
    returns ..;
    _L41= SpeedTarget;
    _L42= AltitudeTarget;
    JV_Alti_Alarm= _L34;
    SDY_Airspeed= _L15;
    _L43= MCP_UnlockRoll;
  tel

