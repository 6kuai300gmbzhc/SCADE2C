    speedSetpoint= _L10;
  tel

  node FCU(
      speed : float32;
      altitude : float32;
      MCPaltitude : float32;
      MCPspeed : float32;
      AutoPilot : bool;
      MCP_UnlockRoll : bool)
    returns (
      throttleCmd : float32;
      elevatorCmd : float32;
      SDY_Airspeed : float32;
      SDY_Pitch_Angle : float32;
      SDY_Roll_Angle : float32;
      SDY_Alti : float32;
