    _L3= #6 fby(_L32; 1; 0.0);
    _L4= _L32 #5 - _L3;
    _L5= _L4 #3 / _L10;
    _L6= #1 mathext::AtanR(_L5);
    _L16= _L20 #4 / _L34;
    _L20= #5 UnitConvert(_L6, RDtoDEG);
    _L10= #2 pwlinear::LimiterUnSymmetrical(_L33, 0.01, 10000.0);
    _L32= altitude;
    _L33= speed;
    pitch= _L16;
    _L34= libPlane::TimingConstants::Time_cycle #5 * 20.0;
    _L35= 50.0;
    _L36= MCP_UnlockRoll;
    _L37= #1 if _L45 then (_L44) else (_L46);
    roll= _L37;
    _L38= #1 digital::FallingEdge(_L36);
    _L39= (_L42 #1 : float32);
    _L40= 10.0;
    _L41= #2 mathext::SinR(_L43);
    _L42= #2 pwlinear::ClockCounter(_L38);
    _L43= _L39 #2 / _L35;
    _L44= _L41 #6 * _L40;
    _L45= MCP_UnlockRoll;
    _L46= 0.0;
