    _L2, _L3= #2 ComputePitchRoll(_L46, _L48, _L47);
    _L4= #9 UnitConvert(_L46, KMHtoKTS);
    _L40= _L1 #3 / _L42;
    _L42= 100.0;
    _L46= speedSensor;
    _L47= altSensor;
    SDY_Airspeed= _L4;
    SDY_Pitch_Angle= _L2;
    SDY_Roll_Angle= _L3;
