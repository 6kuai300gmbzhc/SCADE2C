    _L11= #1 UnitConvert(_L15, KTStoKMH);
    _L12= #2 UnitConvert(_L18, FTtoM);
    _L13= #2 SetPointMgt(_L17, _L12, _L16);
    _L14= speed;
    speedSensor= _L14;
    _L15= MCPspeed;
    _L16= Autopilot;
    _L17= altitude;
    _L18= MCPaltitude;
    altSensor= _L17;
