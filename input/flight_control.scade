  node AlarmManagerSingle(
      Sensor : float32;
      Setpoint : float32;
      AlarmThreshold : float32;
      AlarmConfirmedTimer : int32)
    returns (AlarmConfirmed : bool default = false)
  var
    Alarm : bool;
    _L17 : bool;
    _L18 : float32;
    _L19 : float32;
  let
    _L17= #1 DetectRegulationError(_L18, _L19, AlarmThreshold);

    automaton AlarmMgt
      state Alarm
        unless
          if #1 not Alarm restart NoAlarm;
        let

          automaton SubAlarmMgt
            state Confirmed
              var
                _L2 : bool;
              let
                _L2= true;
                AlarmConfirmed= _L2;
              tel

            initial state Fugitive
              unless
                if AlarmConfirmedTimer #0 times true restart Confirmed;
              let
              tel
          returns ..;
        tel

      initial state NoAlarm
        unless
          if Alarm restart Alarm;
        let
        tel
    returns ..;
    Alarm= _L17;
    _L18= Sensor;
    _L19= Setpoint;
  tel

