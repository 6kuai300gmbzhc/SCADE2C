function exprs() returns()
    let
        a,_,c,_ = b;
        t = 'T;
        f = last 'B;
        f = true;
        V = b -> a;
        E = pre L;
        F =fby(a,b ; e ; c,d);
        G = a times b;
        H = a when (t match -2);
        I = merge (a ; c,d ; e,f);
        J = (s : uint8);
        K = lnot b;
        L = a+b;
        M = a <> b;
        N = (a,b,d,f);
        O = if a then b else c;
        P = (case a of |-2 : d |true : e);
        Q = not q;
        R = r and l;
        S = #(a,b,c,d);
        T = a.b;
        U = {a:b,c:d};
        V = reverse a;
        W = p[1];
        X = a @ b;
        Y = (a.[b][c] default 1);
        Y = p[1..2];
        Z = transpose(a;1;3);
        ZZ = a^3;
        ZY = [a,b,c,d];
        ZX = (a with .T =1);
        A0 = p[1 .. 2];
        A1 = a(b,c);
        A2 = (a<<1>>)(b);
        A3 = $=$(b);
        A4 = ($mod$<<3>>)(c);
        A5 = (make p)(d);
        A6 = (flatten p)(d);
        A7 = (mapfold 3 a <<1>>)(f);
        A8 = (activate a every (blue match true))(f);
        A9 = (activate a every not P default 1)(f);
        A10 = (activate a every not P initial default 1)(f);
        A11 = (restart x every false)(o);
        A12 = (mapfoldw 3 a <<1>> if true default false)(f);
        A13 = (foldw a <<1>> if true)(f);
        A14 = (foldwi a <<1>> if true)(f);
        emit 's1;
        emit ('s1,'s2) if A14;
        guarantee t : 1;
        assume b : 1;
    tel