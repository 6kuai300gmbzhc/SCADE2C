function IFBLOCK() returns()
    let
      activate IfBlock1 if Set
      then var
        _L2 : tSpeed;
      let
        _L2= Speed;
        LocalCruiseSpeed= _L2;
      tel
      else if QuickAccel
      then var
        _L1 : tSpeed;
        _L2 : float32;
        _L3 : tSpeed;
      let
        _L1= last 'CruiseSpeed;
        _L2= _L1 #1 + _L3;
        LocalCruiseSpeed= _L2;
        _L3= SpeedInc;
      tel
      else if QuickDecel
      then
        if testthen
        then
      var
        _L2 : tSpeed;
        _L4 : float32;
        _L3 : tSpeed;
      let
        _L2= last 'CruiseSpeed;
        _L4= _L2 #1 - _L3;
        LocalCruiseSpeed= _L4;
        _L3= SpeedInc;
      tel
      else var
        _L1 : tSpeed;
      let
        _L1= last 'CruiseSpeed;
        LocalCruiseSpeed= _L1;
      tel
      else var
        _L1 : tSpeed;
      let
        _L1= last 'CruiseSpeed;
        LocalCruiseSpeed= _L1;
      tel
      returns ..;
    tel