node arith_test(in1,in2,in3:int64;in4,in5:uint64) returns(out1,out3,o5,o6,o7,o8,o9:int64;out2:int32;o4,o11,o12,o13,o14,o15:uint64)
let
	out1=-in1;
	out2=(in2:int32);
	out3=+in1;
	o4=lnot(in4);
	o5=in1+in2;
	o6=in1-in2;
	o7=in1*in2;
	o8=in1/in2;
	o9=in1 mod in2;
	o11=in4 land in5;
	o12=in4 lor in5;
	o13=in4 lxor in5;
	o14=in4 lsl in5;
	o15=in4 lsr in5;
tel

node relation_test(in1,in2:bool;in3,in4:int64) returns(o1,o2,o3,o4,o5,o6:bool)
let
	o1 = in3 = in4;
	o2 = in3 <> in4;
	o3= in3 < in4;
	o4=in3 > in4;
	o5=in3 <= in4;
	o6=in3 >= in4;
tel

node atom_test() returns(o1:bool)
let
	o1=true;
tel

node bool_test(in1,in2,in5:int64;in3,in4,in6:bool) returns(o1,o2,o3,o4,o5:bool)
let
	o1= not in3;
	o2 =#(in3,in4,in6);
	o3 = in3 and in4;
	o4 = in3 or in4;
	o5 = in3 xor in4;
tel

node switch_expr(in1,in2:int64) returns(out1:int64)
let
	out1= if in1<in2 then in1+in2 else in1-in2;
tel

node list_test1(in1,in2,in3:int64) returns(out1,out2,out3,out4,out5:int64)
let
	out3=in1-in2;
	out4=in3+in2;
	out5=in3;
	out1=in1->pre(out3);
	out2=in2->pre(out4);
tel
